  "about": {
    "eyebrow": "About",
    "title": "What is {site}?",
    "lead": "An archive of apps, games and software worth your time — fast, ad-free and always up to date.",
    "approachTitle": "Approach",
    "approachText": "Every post is a JavaScript file; pages read them in the browser and build themselves. No database, no server code — just fast, cheap and easy-to-maintain pages.",
    "whatTitle": "What we publish",
    "what1": "App reviews, release notes and download guides",
    "what2": "Game reviews, mods and installation walkthroughs",
    "what3": "Tools, tips and how-to articles",
    "techTitle": "Technology",
    "techText": "HTML, CSS and JavaScript. CKEditor 5 for writing, Fancybox for galleries, Disqus for comments. Every library is served locally — no CDN.",
    "contribTitle": "Contribute",
    "contribText": "Use the publishing studio to submit a post or report a fix, or reach us through the contact channels.",

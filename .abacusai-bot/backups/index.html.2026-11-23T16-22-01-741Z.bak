<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PrePortal — Uygulama, oyun ve yazılım arşivi</title>
  <meta name="description" content="PrePortal — APK, oyun ve yazılım incelemeleri, rehberler ve güncelleme notları. Sunucusuz, statik ama dinamik blog.">
  <meta name="theme-color" content="#070b18">
  <link rel="icon" href="assets/img/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="PrePortal">
  <meta property="og:title" content="PrePortal — Uygulama, oyun ve yazılım arşivi">
  <meta property="og:description" content="APK, oyun ve yazılım incelemeleri, rehberler ve güncelleme notları.">
  <meta property="og:image" content="assets/img/logo-256.png">
  <link rel="stylesheet" href="assets/css/theme.css">
  <script>
    /* tema, ilk boyamada uygulanır (flash yok) */
    (function () {
      try {
        var m = localStorage.getItem('preportal:theme') || 'dark';
        var r = m === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : m;
        document.documentElement.setAttribute('data-theme', r === 'light' ? 'light' : 'dark');
      } catch (e) {}
    })();
  </script>
</head>
<body data-page="index">

  <header class="site-header" data-header></header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div>
          <span class="eyebrow">Sunucusuz · GitHub Pages · JavaScript</span>
          <h1><span class="grad">Uygulama ve oyun</span> dünyasına açılan portal</h1>
          <p class="hero-lead">
            PrePortal; APK, oyun ve yazılım incelemelerini tek çatı altında toplar.
            Statik dosyalarla çalışır, JavaScript ile dinamik davranır: yazıyı yazın,
            tek tıkla yayına hazır dosyayı alın.
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary btn--lg" href="blog.html">Arşivi keşfet</a>
            <a class="btn btn--ghost btn--lg" href="create.html">Yazı oluştur</a>
          </div>
          <div class="hero-stats" id="heroStats"></div>
        </div>

        <div id="heroCard" aria-live="polite"></div>
      </div>
    </section>

    <!-- SON YAZILAR -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Arşiv</span>
            <h2>Son eklenenler</h2>
            <p>En yeni incelemeler, rehberler ve güncelleme notları.</p>
          </div>
          <a class="btn btn--ghost btn--sm" href="blog.html">Tümünü gör</a>
        </div>
        <div class="grid grid--posts" id="latestPosts" aria-live="polite">
          <div class="skeleton" style="height:300px"></div>
          <div class="skeleton" style="height:300px"></div>
          <div class="skeleton" style="height:300px"></div>
        </div>
      </div>
    </section>

    <!-- KATEGORİLER -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Kategoriler</span>
            <h2>Konuya göre göz at</h2>
          </div>
          <a class="btn btn--ghost btn--sm" href="category.html">Tüm kategoriler</a>
        </div>
        <div class="grid grid--3" id="homeCategories"></div>
      </div>
    </section>

    <!-- NASIL ÇALIŞIR -->
    <section class="section">
      <div class="container">
        <div class="grid grid--sidebar">
          <div>
            <span class="eyebrow">Sistem</span>
            <h2>Statik altyapı, dinamik içerik</h2>
            <p class="muted">
              PrePortal'da veritabanı yok. Her yazı <code>p/</code> klasöründe küçük bir
              JavaScript dosyasıdır; sayfalar bu dosyaları okuyup anında oluşturur.
              Böylece GitHub Pages gibi sunucusuz ortamlarda tam bir blog deneyimi elde edilir.
            </p>
            <div class="grid grid--3" style="margin-top:24px">
              <div class="panel" data-reveal>
                <h4>1 · Yaz</h4>
                <p class="muted" style="font-size:.86rem;margin:0">CKEditor 5 ile zengin içerik hazırla, görselleri sürükle-bırak ekle.</p>
              </div>
              <div class="panel" data-reveal>
                <h4>2 · Kopyala</h4>
                <p class="muted" style="font-size:.86rem;margin:0">Yayın aracı hazır <code>p/slug.js</code> dosyasını üretir; indir ya da kopyala.</p>
              </div>
              <div class="panel" data-reveal>
                <h4>3 · Yayınla</h4>
                <p class="muted" style="font-size:.86rem;margin:0">Dosyayı repoya <code>p/</code> klasörüne ekle, dizine bir satır yaz. Bitti.</p>
              </div>
            </div>
            <p class="muted" style="margin-top:18px;font-size:.84rem" id="howStats"></p>
          </div>

          <aside class="sidebar">
            <div class="panel">
              <h4>Etiketler</h4>
              <div class="tag-cloud" id="homeTags"></div>
            </div>
            <div class="panel">
              <h4>Hızlı bağlantılar</h4>
              <ul class="cat-list">
                <li><a href="apps.html">Uygulamalar</a></li>
                <li><a href="games.html">Oyunlar</a></li>
                <li><a href="category.html">Kategoriler</a></li>
                <li><a href="create.html?tab=publish">Yayın aracı</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" data-footer></footer>

  <script src="data/config.js"></script>
  <script src="data/posts.js"></script>
  <script src="data/categories.js"></script>
  <script src="data/users.js"></script>
  <script src="assets/js/core.js"></script>
  <script src="assets/js/home.js"></script>
  <script>
    window.PrePortal.ready();
  </script>
</body>
</html>

/* =====================================================================
   PrePortal — yazı oluşturma stüdyosu (create.html)
   CKEditor 5 · otomatik kayıt · görsel yükleme · yayın aracı
   ===================================================================== */
(function () {
  var P = window.PrePortal;
  var LS_KEY = 'preportal:draft';
  var LS_LIST = 'preportal:drafts';

  var state = {
    editor: null,
    images: [],          // yüklenen görseller {name, path, url}
    current: null,       // {post, category, user} üretilen çıktı
    autosaveTimer: null,
    dirty: false
  };

  document.addEventListener('preportal:ready', function () {
    var host = P.qs('#editorRoot');
    if (!host) return;

    buildForm();
    initEditor();
    wireTabs();
    wireMeta();
    wireDrafts();
    restoreDraft();
  });

  /* ---------------------------------------------------------- form */
  function buildForm() {
    var catOptions = P.categoriesWithCount().map(function (c) {
      return '<option value="' + P.esc(c.slug) + '">' + P.esc(c.name) + '</option>';
    }).join('');

    var userOptions = Object.keys(P.Store.users).map(function (k) {
      return '<option value="' + P.esc(k) + '">' + P.esc(P.Store.users[k].name) + '</option>';
    }).join('');

    var preCat = P.param('cat') || '';

    P.qs('#editorRoot').innerHTML = [
      '<div class="tabs-bar">',
      '<div class="tabs" role="tablist" aria-label="Stüdyo sekmeleri">',
      '<button class="tab is-active" type="button" role="tab" aria-selected="true" data-tab="write" id="tabWrite">', P.icon('pen', 16), 'Yaz</button>',
      '<button class="tab" type="button" role="tab" aria-selected="false" data-tab="preview" id="tabPreview">', P.icon('eye', 16), 'Önizleme</button>',
      '<button class="tab" type="button" role="tab" aria-selected="false" data-tab="publish" id="tabPublish">', P.icon('code', 16), 'Yayın aracı</button>',
      '</div>',
      '<div class="editor-status"><span class="dot" id="saveDot"></span><span id="saveState">Hazır</span></div>',
      '</div>',

      '<div class="studio-grid">',
      '<div>',

      /* --- YAZ --- */
      '<section id="paneWrite" role="tabpanel" aria-labelledby="tabWrite">',
      '<div class="editor-shell">',
      '<div class="editor-toolbar-top">',
      '<span class="file-pill">' + P.icon('code', 15) + '<span id="slugPreview">p/yeni-yazi.js</span></span>',
      '<div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">',
      '<button class="btn btn--ghost btn--sm" type="button" id="btnSave">', P.icon('save', 15), 'Kaydet</button>',
      '<button class="btn btn--ghost btn--sm" type="button" id="btnFullscreen">', P.icon('sparkle', 15), 'Odak modu</button>',
      '</div>',
      '</div>',
      '<div id="editorMount"></div>',
      '</div>',
      '</section>',

      /* --- ÖNİZLEME --- */
      '<section id="panePreview" role="tabpanel" aria-labelledby="tabPreview" hidden>',
      '<div class="preview-frame"><div class="prose" id="previewBody"></div></div>',
      '</section>',

      /* --- YAYIN --- */
      '<section id="panePublish" role="tabpanel" aria-labelledby="tabPublish" hidden>',
      '<div class="panel">',
      '<h4>Üretilen dosya</h4>',
      '<div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px">',
      '<span class="file-pill">' + P.icon('code', 15) + '<span id="outFileName">p/yeni-yazi.js</span></span>',
      '<button class="btn btn--primary btn--sm" type="button" id="btnCopyCode">', P.icon('copy', 15), 'Kodu kopyala</button>',
      '<button class="btn btn--soft btn--sm" type="button" id="btnDownloadCode">', P.icon('download', 15), 'Dosyayı indir</button>',
      '</div>',
      '<pre class="code-output" id="codeOut" tabindex="0"></pre>',
      '<div id="extraFiles" style="display:flex;flex-direction:column;gap:10px;margin-top:12px"></div>',
      '</div>',

      '<div class="panel" style="margin-top:16px">',
      '<h4>Yayın adımları</h4>',
      '<div class="publish-steps" id="publishSteps"></div>',
      '</div>',

      '<div class="panel" style="margin-top:16px">',
      '<h4>Yükteki görseller</h4>',
      '<div id="imageList" class="draft-list"><span class="muted" style="font-size:.84rem">Henüz görsel yüklenmedi.</span></div>',
      '</div>',
      '</section>',

      '</div>',

      /* --- KENAR ÇUBUĞU: META --- */
      '<aside class="sidebar">',
      '<div class="panel">',
      '<h4>Yazı bilgileri</h4>',
      '<div class="form-grid" style="grid-template-columns:1fr">',

      '<div class="form-row">',
      '<label class="label" for="fTitle">Başlık <span class="required">*</span></label>',
      '<input class="input" id="fTitle" type="text" placeholder="Örn. En iyi 10 Android uygulaması" maxlength="140" autocomplete="off">',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fSlug">Dosya adı (slug)</label>',
      '<input class="input" id="fSlug" type="text" placeholder="otomatik-uretilir" autocomplete="off" spellcheck="false">',
      '<span class="hint">Adres: <code>post.html?slug=…</code> · Dosya: <code>p/slug.js</code></span>',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fExcerpt">Özet</label>',
      '<textarea class="textarea" id="fExcerpt" rows="3" placeholder="Kartlarda ve arama sonuçlarında görünecek kısa açıklama" maxlength="260"></textarea>',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fCat">Kategori</label>',
      '<div class="select-wrap"><select class="select" id="fCat">' + (catOptions || '<option value="genel">genel</option>') + '</select></div>',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fAuthor">Yazar</label>',
      '<div class="select-wrap"><select class="select" id="fAuthor">' + (userOptions || '<option value="preportal">PrePortal</option>') + '</select></div>',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fTags">Etiketler</label>',
      '<input class="input" id="fTags" type="text" placeholder="android, apk, rehber" autocomplete="off">',
      '<span class="hint">Virgülle ayırın.</span>',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fDate">Tarih</label>',
      '<input class="input" id="fDate" type="datetime-local">',
      '</div>',

      '<div class="form-row">',
      '<label class="label" for="fCover">Kapak görseli</label>',
      '<input class="input" id="fCover" type="text" placeholder="assets/img/kapak.webp veya https://…" autocomplete="off">',
      '<button class="btn btn--ghost btn--sm" type="button" id="btnPickCover">', P.icon('upload', 15), 'Görsel seç</button>',
      '<input type="file" id="coverFile" accept="image/*" hidden>',
      '</div>',

      '<label class="label" style="gap:8px;cursor:pointer"><input type="checkbox" id="fFeatured"> Öne çıkan yazı</label>',
      '</div>',
      '</div>',

      '<div class="panel">',
      '<h4>Uygulama bilgileri <span class="pill">opsiyonel</span></h4>',
      '<div class="form-grid" style="grid-template-columns:1fr">',
      '<div class="form-row"><label class="label" for="fVersion">Sürüm</label><input class="input" id="fVersion" placeholder="1.4.2"></div>',
      '<div class="form-row"><label class="label" for="fSize">Boyut</label><input class="input" id="fSize" placeholder="42 MB"></div>',
      '<div class="form-row"><label class="label" for="fPlatform">Platform</label><input class="input" id="fPlatform" placeholder="Android 8.0+"></div>',
      '<div class="form-row"><label class="label" for="fDownloads">İndirme bağlantıları</label>',
      '<textarea class="textarea" id="fDownloads" rows="3" placeholder="APK | https://ornek.com/app.apk&#10;MOD | https://ornek.com/app-mod.apk"></textarea>',
      '<span class="hint">Her satır: <code>Etiket | URL</code></span></div>',
      '</div>',
      '</div>',

      '<div class="panel">',
      '<h4>Kayıtlı taslaklar</h4>',
      '<div class="draft-list" id="draftList"></div>',
      '<button class="btn btn--danger btn--sm" type="button" id="btnClearDraft" style="margin-top:12px;width:100%">', P.icon('trash', 15), 'Taslağı temizle</button>',
      '</div>',
      '</aside>',
      '</div>'
    ].join('');

    if (preCat) {
      var sel = P.qs('#fCat');
      if (sel) sel.value = preCat;
    }
    var d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    P.qs('#fDate').value = d.toISOString().slice(0, 16);
  }

  /* ---------------------------------------------------------- CKEditor */
  /** Yüklenen CKEditor sürümünde gerçekten var olan eklentileri seçer */
  function resolvedPlugins() {
    var C = window.CKEDITOR || {};
    var list = ['Essentials', 'Paragraph', 'Heading', 'Bold', 'Italic', 'Underline', 'Strikethrough',
      'Subscript', 'Superscript', 'Code', 'CodeBlock', 'Link', 'AutoLink', 'List', 'TodoList',
      'Alignment', 'BlockQuote', 'Indent', 'HorizontalLine', 'Table', 'TableToolbar', 'Image',
      'ImageToolbar', 'ImageCaption', 'ImageStyle', 'ImageInsert', 'ImageUpload', 'ImageResize',
      'MediaEmbed', 'HtmlEmbed', 'Autoformat', 'Font', 'FontColor', 'FontBackgroundColor',
      'FontSize', 'Highlight', 'RemoveFormat', 'SpecialCharacters', 'FindAndReplace',
      'SourceEditing', 'PasteFromOffice', 'ShowBlocks', 'WordCount', 'GeneralHtmlSupport',
      'Style', 'Fullscreen'];
    var plugins = [];
    list.forEach(function (name) { if (C[name]) plugins.push(C[name]); });
    if (!plugins.length) throw new Error('CKEditor eklentileri bulunamadı');
    return plugins;
  }


  function initEditor() {
    var mount = P.qs('#editorMount');
    if (!window.CKEDITOR || !window.CKEDITOR.ClassicEditor) {
      mount.innerHTML = '<textarea id="fallbackEditor" style="min-height:420px;width:100%;padding:16px;background:var(--surface);border:0;color:var(--text)"></textarea>';
      var ta = P.qs('#fallbackEditor');
      ta.addEventListener('input', scheduleAutosave);
      state.editor = {
        getData: function () { return ta.value; },
        setData: function (v) { ta.value = v || ''; },
        fallback: true
      };
      P.toast('CKEditor yüklenemedi, basit düzenleyici kullanılıyor', 'warn');
      return;
    }

    var uploadAdapter = createUploadAdapter();

    window.CKEDITOR.ClassicEditor.create(mount, {
      licenseKey: 'GPL',
      translations: [window.CKEDITOR_TRANSLATIONS && window.CKEDITOR_TRANSLATIONS.tr ? window.CKEDITOR_TRANSLATIONS.tr : undefined].filter(Boolean),
      language: 'tr',
      initialData: '',
      placeholder: 'Yazmaya başlayın… Görselleri sürükleyip bırakabilirsiniz.',
      plugins: resolvedPlugins(),
      toolbar: {
        items: [
          'undo', 'redo', '|',
          'heading', 'style', '|',
          'bold', 'italic', 'underline', 'strikethrough', 'code', '|',
          'fontSize', 'fontColor', 'fontBackgroundColor', 'highlight', '|',
          'bulletedList', 'numberedList', 'todoList', '|',
          'outdent', 'indent', 'alignment', '|',
          'link', 'insertImage', 'mediaEmbed', 'insertTable', 'blockQuote', 'codeBlock', 'horizontalLine', 'specialCharacters', '|',
          'removeFormat', 'sourceEditing', 'fullscreen'
        ],
        shouldNotGroupWhenFull: true
      },
      heading: {
        options: [
          { model: 'paragraph', title: 'Paragraf', class: 'ck-heading_paragraph' },
          { model: 'heading2', view: 'h2', title: 'Başlık 2', class: 'ck-heading_heading2' },
          { model: 'heading3', view: 'h3', title: 'Başlık 3', class: 'ck-heading_heading3' },
          { model: 'heading4', view: 'h4', title: 'Başlık 4', class: 'ck-heading_heading4' }
        ]
      },
      image: {
        resizeUnit: '%',
        resizeOptions: [
          { name: 'resizeImage:original', value: null, label: 'Orijinal' },
          { name: 'resizeImage:25', value: '25', label: '25%' },
          { name: 'resizeImage:50', value: '50', label: '50%' },
          { name: 'resizeImage:75', value: '75', label: '75%' }
        ],
        toolbar: ['imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|', 'toggleImageCaption', 'imageTextAlternative', '|', 'resizeImage', '|', 'linkImage']
      },
      table: {
        contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells', 'tableProperties', 'tableCellProperties']
      },
      link: { addTargetToExternalLinks: true, defaultProtocol: 'https://' },
      htmlSupport: {
        allow: [{ name: /.*/, attributes: true, classes: true, styles: true }]
      },
      wordCount: { onUpdate: function (stats) { updateCounters(stats); } },
      extraPlugins: [uploadAdapter.plugin]
    }).then(function (editor) {
      state.editor = editor;
      editor.model.document.on('change:data', function () {
        state.dirty = true;
        scheduleAutosave();
      });
      P.toast('CKEditor 5 hazır', 'success');
    }).catch(function (err) {
      console.error(err);
      mount.innerHTML = '<textarea id="fallbackEditor" style="min-height:420px;width:100%;padding:16px;background:var(--surface);border:0;color:var(--text)"></textarea>';
      var ta = P.qs('#fallbackEditor');
      ta.addEventListener('input', scheduleAutosave);
      state.editor = { getData: function () { return ta.value; }, setData: function (v) { ta.value = v || ''; }, fallback: true };
      P.toast('Düzenleyici yüklenemedi: ' + (err && err.message ? err.message : 'bilinmeyen hata'), 'error');
    });
  }

  function updateCounters(stats) {
    var el = P.qs('#saveState');
    if (!el || state.editor == null) return;
    // durum satırı kayıt bilgisini gösterir; kelime sayısı toast yerine ipucunda
    P.qs('#slugPreview').setAttribute('title', stats.words + ' kelime · ' + stats.characters + ' karakter');
  }

  /* ---------------------------------------------------------- görsel yükleme */
  function createUploadAdapter() {
    function UploadAdapter(loader) { this.loader = loader; }

    UploadAdapter.prototype.upload = function () {
      var self = this;
      return this.loader.file.then(function (file) { return handleFile(file, self.loader); });
    };
    UploadAdapter.prototype.abort = function () { };

    return {
      plugin: function (editor) {
        editor.plugins.get('FileRepository').createUploadAdapter = function (loader) {
          return new UploadAdapter(loader);
        };
      }
    };
  }

  /** Görseli seçilen moda göre hazırlar: ImgBB, GitHub API veya repoya eklenecek dosya */
  async function handleFile(file, loader) {
    if (!file || !/^image\//.test(file.type)) throw new Error('Yalnızca görsel dosyaları yüklenebilir.');
    if (file.size > 8 * 1024 * 1024) throw new Error('Görsel 8 MB sınırını aşıyor.');

    var cfg = P.CFG.media || { mode: 'repo' };

    if (cfg.mode === 'imgbb' && cfg.imgbbKey) {
      var fd = new FormData();
      fd.append('image', file);
      var res = await fetch('https://api.imgbb.com/1/upload?key=' + encodeURIComponent(cfg.imgbbKey), { method: 'POST', body: fd });
      var json = await res.json();
      if (!json.success) throw new Error('ImgBB yüklemesi başarısız.');
      var url = json.data.display_url || json.data.url;
      pushImage(file.name, url);
      return { default: url };
    }

    if (cfg.mode === 'github' && cfg.githubToken && cfg.githubOwner && cfg.githubRepo) {
      var b64 = await fileToBase64(file);
      var path = (P.CFG.mediaDir || 'assets/img') + '/' + Date.now() + '-' + safeName(file.name);
      var api = 'https://api.github.com/repos/' + cfg.githubOwner + '/' + cfg.githubRepo + '/contents/' + encodeURIComponent(path).replace(/%2F/g, '/');
      var r = await fetch(api, {
        method: 'PUT',
        headers: { Authorization: 'Bearer ' + cfg.githubToken, 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: 'chore(media): ' + file.name, content: b64.replace(/^data:[^,]+,/, ''), branch: cfg.githubBranch || 'main' })
      });
      if (!r.ok) throw new Error('GitHub yüklemesi başarısız (' + r.status + ').');
      var j = await r.json();
      var raw = j.content && j.content.download_url ? j.content.download_url : path;
      pushImage(file.name, raw);
      return { default: raw };
    }

    /* repo modu: dosyayı kullanıcı elle repoya ekler; yol üretilir */
    var localPath = (P.CFG.mediaDir || 'assets/img') + '/' + safeName(file.name);
    var dataUrl = await readAsDataURL(file);
    pushImage(file.name, localPath, dataUrl);
    P.toast('Görsel hazır: dosyayı ' + localPath + ' olarak repoya eklemeyi unutmayın', 'warn');
    return { default: dataUrl };
  }

  function pushImage(name, path, dataUrl) {
    state.images.push({ name: name, path: path, dataUrl: dataUrl || '' });
    renderImageList();
  }

  function renderImageList() {
    var host = P.qs('#imageList');
    if (!host) return;
    if (!state.images.length) {
      host.innerHTML = '<span class="muted" style="font-size:.84rem">Henüz görsel yüklenmedi.</span>';
      return;
    }
    host.innerHTML = state.images.map(function (img, i) {
      return '<div class="draft-item">' + P.icon('link', 15) +
        '<span><b>' + P.esc(img.name) + '</b><br><small>' + P.esc(img.path) + '</small></span>' +
        '<button class="icon-btn" type="button" data-copy-img="' + i + '" aria-label="Yolu kopyala">' + P.icon('copy', 15) + '</button>' +
        (img.dataUrl ? '<button class="icon-btn" type="button" data-dl-img="' + i + '" aria-label="Görseli indir">' + P.icon('download', 15) + '</button>' : '') +
        '</div>';
    }).join('');
    P.qsa('[data-dl-img]', host).forEach(function (b) {
      b.addEventListener('click', function () {
        var img = state.images[Number(b.getAttribute('data-dl-img'))];
        var a = document.createElement('a');
        a.href = img.dataUrl;
        a.download = img.path.split('/').pop();
        a.click();
        P.toast('Görsel indirildi: ' + a.download, 'success');
      });
    });
    P.qsa('[data-copy-img]', host).forEach(function (b) {
      b.addEventListener('click', async function () {
        var img = state.images[Number(b.getAttribute('data-copy-img'))];
        var ok = await P.copyText(img.path);
        P.toast(ok ? 'Yol kopyalandı: ' + img.path : 'Kopyalanamadı', ok ? 'success' : 'error');
      });
    });
  }

  function readAsDataURL(file) {
    return new Promise(function (res) {
      var fr = new FileReader();
      fr.onload = function () { res(fr.result); };
      fr.readAsDataURL(file);
    });
  }
  function fileToBase64(file) { return readAsDataURL(file); }
  function safeName(name) {
    return P.slugify(name.replace(/\.[^.]+$/, '')) + (name.match(/\.[^.]+$/) ? name.match(/\.[^.]+$/)[0].toLowerCase() : '');
  }

  /* ---------------------------------------------------------- görseller (kapak) */
  function wireImages() { /* kapak seçimi wireMeta içinde ele alınır */ }

  /* ---------------------------------------------------------- meta alanları */
  function wireMeta() {
    var title = P.qs('#fTitle');
    var slug = P.qs('#fSlug');

    title.addEventListener('input', function () {
      if (!slug.dataset.touched) slug.value = P.slugify(title.value);
      updateSlugLabel();
      scheduleAutosave();
    });
    slug.addEventListener('input', function () {
      slug.dataset.touched = '1';
      slug.value = P.slugify(slug.value);
      updateSlugLabel();
      scheduleAutosave();
    });
    ['#fExcerpt', '#fCat', '#fAuthor', '#fTags', '#fDate', '#fCover', '#fVersion', '#fSize', '#fPlatform', '#fDownloads'].forEach(function (sel) {
      var el = P.qs(sel);
      if (el) el.addEventListener('input', scheduleAutosave);
      if (el) el.addEventListener('change', scheduleAutosave);
    });
    P.qs('#fFeatured').addEventListener('change', scheduleAutosave);

    P.qs('#btnSave').addEventListener('click', function () { saveDraft(true); });
    P.qs('#btnFullscreen').addEventListener('click', function () {
      var shell = P.qs('.editor-shell');
      shell.classList.toggle('is-focus');
      shell.style.position = shell.classList.contains('is-focus') ? 'fixed' : '';
      shell.style.inset = shell.classList.contains('is-focus') ? '0' : '';
      shell.style.zIndex = shell.classList.contains('is-focus') ? '150' : '';
      shell.style.borderRadius = shell.classList.contains('is-focus') ? '0' : '';
      shell.style.background = 'var(--surface)';
    });

    P.qs('#btnPickCover').addEventListener('click', function () { P.qs('#coverFile').click(); });
    P.qs('#coverFile').addEventListener('change', async function (e) {
      var f = e.target.files && e.target.files[0];
      if (!f) return;
      try {
        var out = await handleFile(f, null);
        P.qs('#fCover').value = out.default && out.default.indexOf('data:') === 0 ? (state.images[state.images.length - 1].path) : out.default;
        P.toast('Kapak görseli eklendi', 'success');
      } catch (err) {
        P.toast(err.message || 'Görsel eklenemedi', 'error');
      }
    });
  }

  function updateSlugLabel() {
    var s = P.qs('#fSlug').value || 'yeni-yazi';
    P.qs('#slugPreview').textContent = (P.CFG.postsDir || 'p') + '/' + s + '.js';
    var out = P.qs('#outFileName');
    if (out) out.textContent = (P.CFG.postsDir || 'p') + '/' + s + '.js';
  }

  /* ---------------------------------------------------------- sekmeler */
  function wireTabs() {
    P.qsa('[data-tab]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tab = btn.getAttribute('data-tab');
        P.qsa('[data-tab]').forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        P.qs('#paneWrite').hidden = tab !== 'write';
        P.qs('#panePreview').hidden = tab !== 'preview';
        P.qs('#panePublish').hidden = tab !== 'publish';
        if (tab === 'preview') renderPreview();
        if (tab === 'publish') buildOutput();
      });
    });

    var tab = P.param('tab');
    if (tab === 'publish') P.qs('#tabPublish').click();
    if (tab === 'preview') P.qs('#tabPreview').click();
  }

  /* ---------------------------------------------------------- veri toplama */
  function collect() {
    var get = function (id) { var el = P.qs('#' + id); return el ? el.value.trim() : ''; };
    var slug = P.slugify(get('fSlug') || get('fTitle'));
    var content = state.editor ? state.editor.getData() : '';
    var downloads = get('fDownloads').split('\n').map(function (line) {
      line = line.trim();
      if (!line) return null;
      var parts = line.split('|');
      var url = (parts[1] || parts[0]).trim();
      return { label: (parts[1] ? parts[0] : 'İndir').trim(), url: url };
    }).filter(Boolean);

    var dateVal = get('fDate');
    var date = dateVal ? new Date(dateVal).toISOString() : new Date().toISOString();

    return {
      slug: slug,
      title: get('fTitle') || 'Başlıksız yazı',
      excerpt: get('fExcerpt'),
      content: content,
      category: get('fCat') || 'genel',
      author: get('fAuthor') || 'preportal',
      tags: get('fTags').split(',').map(function (t) { return t.trim(); }).filter(Boolean),
      date: date,
      updated: new Date().toISOString(),
      cover: get('fCover'),
      featured: P.qs('#fFeatured').checked,
      version: get('fVersion'),
      size: get('fSize'),
      platform: get('fPlatform'),
      downloads: downloads,
      status: 'published'
    };
  }

  function validate(post) {
    var errs = [];
    if (!P.qs('#fTitle').value.trim()) errs.push('Başlık zorunlu.');
    if (!post.content || P.stripTags(post.content).length < 20) errs.push('İçerik en az 20 karakter olmalı.');
    return errs;
  }

  /* ---------------------------------------------------------- önizleme */
  function renderPreview() {
    var post = collect();
    P.qs('#previewBody').innerHTML = [
      '<span class="badge badge--accent">' + P.esc(P.getCategory(post.category).name) + '</span>',
      '<h1 style="margin:12px 0 10px">' + P.esc(post.title) + '</h1>',
      post.excerpt ? '<p class="article-lead">' + P.esc(post.excerpt) + '</p>' : '',
      '<div class="article-meta" style="margin:16px 0 26px">',
      '<span class="meta-item">' + P.icon('user', 14) + P.esc(P.getUser(post.author).name) + '</span>',
      '<span class="meta-item">' + P.icon('clock', 14) + P.esc(P.formatDate(post.date)) + '</span>',
      '<span class="meta-item">' + P.icon('book', 14) + P.readingTime(post.content) + ' dk okuma</span>',
      '</div>',
      post.cover ? '<img src="' + P.esc(post.cover) + '" alt="">' : '',
      post.content
    ].join('');
  }

  /* ---------------------------------------------------------- yayın çıktısı */
  function buildOutput() {
    var post = collect();
    var code = P.publish.buildPostFile(post);
    var out = P.qs('#codeOut');
    out.innerHTML = P.publish.highlight(code);
    state.current = post;

    /* adımlar */
    var postIds = P.publish.withId(window.PREPORTAL_POSTS || [], post.slug);
    var catExists = !!P.Store.categories[post.category];
    var userExists = !!P.Store.users[post.author];

    var steps = [];
    steps.push(step(1, 'Dosyayı ekle',
      '<code>' + (P.CFG.postsDir || 'p') + '/' + post.slug + '.js</code> dosyasını repoya ekleyin. (İndir düğmesi hazır dosyayı verir.)'));
    steps.push(step(2, 'Dizine yaz',
      'Henüz <code>data/posts.js</code> içinde yoksa ekleyin: <code>\'' + post.slug + '\'</code>'));
    if (!catExists) steps.push(step(3, 'Kategori oluştur',
      '<code>' + (P.CFG.categoryDir || 'category') + '/' + post.category + '.js</code> dosyasını oluşturun ve <code>data/categories.js</code> dizinine ekleyin.'));
    if (!userExists) steps.push(step(steps.length + 1, 'Yazar oluştur',
      '<code>' + (P.CFG.usersDir || 'users') + '/' + post.author + '.js</code> dosyasını oluşturun ve <code>data/users.js</code> dizinine ekleyin.'));
    steps.push(step(steps.length + 1, 'Commit & push',
      'Değişiklikleri GitHub\'a gönderin. GitHub Pages birkaç saniye içinde yeni yazıyı yayınlar.'));

    P.qs('#publishSteps').innerHTML = steps.join('');

    /* ek dosya önerileri */
    var extra = [];
    if (!catExists) extra.push({ name: (P.CFG.categoryDir || 'category') + '/' + post.category + '.js', code: P.publish.buildCategoryFile({ slug: post.category, name: ucfirst(post.category), description: '', icon: 'folder' }) });
    if (!userExists) extra.push({ name: (P.CFG.usersDir || 'users') + '/' + post.author + '.js', code: P.publish.buildUserFile({ slug: post.author, name: ucfirst(post.author) }) });
    extra.push({ name: 'data/posts.js', code: P.publish.buildIndexFile('PREPORTAL_POSTS', postIds, 'PrePortal — gönderi dizini (yayın aracı ile güncellendi)') });
    state.extra = extra;

    renderExtraFiles();

    var btnCopy = P.qs('#btnCopyCode');
    btnCopy.onclick = async function () {
      var ok = await P.copyText(code);
      P.toast(ok ? 'Kod kopyalandı' : 'Kopyalanamadı', ok ? 'success' : 'error');
    };
    P.qs('#btnDownloadCode').onclick = function () {
      var errs = validate(post);
      if (errs.length) { P.toast(errs[0], 'warn'); }
      P.download(post.slug + '.js', code);
      P.toast('Dosya indirildi: ' + post.slug + '.js', 'success');
    };
  }


  /** Kategori/yazar/dizin dosyaları: indir + kopyala */
  function renderExtraFiles() {
    var host = P.qs('#extraFiles');
    if (!host) return;
    var extra = state.extra || [];
    if (!extra.length) { host.innerHTML = ''; return; }
    host.innerHTML = extra.map(function (f, i) {
      return '<div class="draft-item" style="flex-wrap:wrap;gap:8px">' +
        P.icon('code', 15) +
        '<span style="min-width:0;flex:1"><b>' + P.esc(f.name) + '</b><br><small>' + P.esc(f.code.split('\n').length + ' satır') + '</small></span>' +
        '<button class="btn btn--ghost btn--sm" type="button" data-extra-copy="' + i + '">' + P.icon('copy', 14) + 'Kopyala</button>' +
        '<button class="btn btn--soft btn--sm" type="button" data-extra-dl="' + i + '">' + P.icon('download', 14) + 'İndir</button>' +
        '</div>';
    }).join('');

    P.qsa('[data-extra-copy]', host).forEach(function (b) {
      b.addEventListener('click', async function () {
        var f = extra[Number(b.getAttribute('data-extra-copy'))];
        var ok = await P.copyText(f.code);
        P.toast(ok ? f.name + ' kopyalandı' : 'Kopyalanamadı', ok ? 'success' : 'error');
      });
    });
    P.qsa('[data-extra-dl]', host).forEach(function (b) {
      b.addEventListener('click', function () {
        var f = extra[Number(b.getAttribute('data-extra-dl'))];
        P.download(f.name.split('/').pop(), f.code);
        P.toast('İndirildi: ' + f.name, 'success');
      });
    });
  }

  function step(n, title, html) {
    return '<div class="publish-step"><span class="publish-step__n">' + n + '</span><div><b>' + P.esc(title) + '</b><p>' + html + '</p></div></div>';
  }
  function ucfirst(s) { return String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1); }

  /* ---------------------------------------------------------- otomatik kayıt */
  function scheduleAutosave() {
    var dot = P.qs('#saveDot');
    if (dot) dot.classList.add('is-saving');
    var st = P.qs('#saveState');
    if (st) st.textContent = 'Yazılıyor…';
    clearTimeout(state.autosaveTimer);
    state.autosaveTimer = setTimeout(function () { saveDraft(false); }, 900);
    updateSlugLabel();
  }

  function saveDraft(manual) {
    var post = collect();
    var payload = { post: post, images: state.images, savedAt: new Date().toISOString() };
    try {
      localStorage.setItem(LS_KEY, JSON.stringify(payload));
      var list = JSON.parse(localStorage.getItem(LS_LIST) || '[]');
      list = list.filter(function (x) { return x.slug !== post.slug; });
      list.unshift({ slug: post.slug, title: post.title, savedAt: payload.savedAt });
      localStorage.setItem(LS_LIST, JSON.stringify(list.slice(0, 8)));
    } catch (e) {
      if (manual) P.toast('Taslak kaydedilemedi (depolama dolu olabilir)', 'error');
      return;
    }
    var dot = P.qs('#saveDot');
    if (dot) dot.classList.remove('is-saving');
    var st = P.qs('#saveState');
    if (st) st.textContent = 'Kaydedildi · ' + new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    if (manual) P.toast('Taslak kaydedildi', 'success');
    renderDrafts();
    state.dirty = false;
  }

  function restoreDraft() {
    var raw;
    try { raw = localStorage.getItem(LS_KEY); } catch (e) { raw = null; }
    if (!raw) return;
    var data;
    try { data = JSON.parse(raw); } catch (e) { return; }
    if (!data || !data.post) return;
    var p = data.post;
    var set = function (id, v) { var el = P.qs('#' + id); if (el) el.value = v || ''; };
    set('fTitle', p.title === 'Başlıksız yazı' ? '' : p.title);
    set('fSlug', p.slug);
    P.qs('#fSlug').dataset.touched = '1';
    set('fExcerpt', p.excerpt);
    set('fTags', (p.tags || []).join(', '));
    set('fCover', p.cover);
    set('fVersion', p.version);
    set('fSize', p.size);
    set('fPlatform', p.platform);
    set('fDownloads', (p.downloads || []).map(function (d) { return (d.label || 'İndir') + ' | ' + d.url; }).join('\n'));
    if (p.category) P.qs('#fCat').value = p.category;
    if (p.author) P.qs('#fAuthor').value = p.author;
    if (p.date) {
      var dt = new Date(p.date);
      dt.setMinutes(dt.getMinutes() - dt.getTimezoneOffset());
      P.qs('#fDate').value = dt.toISOString().slice(0, 16);
    }
    P.qs('#fFeatured').checked = !!p.featured;
    state.images = data.images || [];
    renderImageList();
    if (state.editor) state.editor.setData(p.content || '');
    else {
      // editör henüz yüklenmediyse bekle
      var iv = setInterval(function () {
        if (state.editor) { state.editor.setData(p.content || ''); clearInterval(iv); }
      }, 200);
    }
    updateSlugLabel();
    P.toast('Kaydedilmiş taslak geri yüklendi', 'info');
  }

  function renderDrafts() {
    var host = P.qs('#draftList');
    if (!host) return;
    var list;
    try { list = JSON.parse(localStorage.getItem(LS_LIST) || '[]'); } catch (e) { list = []; }
    host.innerHTML = list.length ? list.map(function (d) {
      return '<div class="draft-item"><span><b>' + P.esc(P.truncate(d.title, 26)) + '</b><br><small>' + P.esc(new Date(d.savedAt).toLocaleString('tr-TR')) + '</small></span></div>';
    }).join('') : '<span class="muted" style="font-size:.84rem">Kayıt yok. Yazmaya başladığınızda otomatik kaydedilir.</span>';
  }

  function wireDrafts() {
    renderDrafts();
    P.qs('#btnClearDraft').addEventListener('click', function () {
      try {
        localStorage.removeItem(LS_KEY);
        localStorage.removeItem(LS_LIST);
      } catch (e) { }
      P.toast('Taslak temizlendi. Sayfa yenileniyor…', 'info');
      setTimeout(function () { location.reload(); }, 700);
    });
    window.addEventListener('beforeunload', function (e) {
      if (state.dirty) { saveDraft(false); }
    });
  }
})();

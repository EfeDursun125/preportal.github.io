/* =====================================================================
   PrePortal — yönetici paneli (admin.html)
   Dizinleri (data/*.js) gösterir, tutarsızlıkları listeler.
   ===================================================================== */
(function () {
  var P = window.PrePortal;

  document.addEventListener('preportal:ready', function () {
    var host = P.qs('#adminStats');
    if (!host) return;

    var posts = P.allPosts();
    var pub = P.publishedPosts();
    var cats = P.categoriesWithCount();
    var users = Object.keys(P.Store.users);

    host.innerHTML = [
      stat(pub.length, 'Yayınlanan yazı'),
      stat(cats.length, 'Kategori'),
      stat(users.length, 'Yazar'),
      stat(P.allTags().length, 'Etiket')
    ].join('');

    /* dizin dosyaları */
    var postIds = (window.PREPORTAL_POSTS || []).slice();
    var catIds = (window.PREPORTAL_CATEGORIES || []).slice();
    var userIds = (window.PREPORTAL_USERS || []).slice();

    var out = {
      posts: P.publish.buildIndexFile('PREPORTAL_POSTS', postIds, 'PrePortal — gönderi dizini'),
      cats: P.publish.buildIndexFile('PREPORTAL_CATEGORIES', catIds, 'PrePortal — kategori dizini'),
      users: P.publish.buildIndexFile('PREPORTAL_USERS', userIds, 'PrePortal — yazar dizini')
    };

    P.qs('#indexPosts').innerHTML = P.publish.highlight(out.posts);
    P.qs('#indexCats').innerHTML = P.publish.highlight(out.cats);
    P.qs('#indexUsers').innerHTML = P.publish.highlight(out.users);

    var fileNames = { posts: 'posts.js', cats: 'categories.js', users: 'users.js' };
    P.qsa('[data-copy]').forEach(function (b) {
      b.addEventListener('click', async function () {
        var key = b.getAttribute('data-copy');
        var ok = await P.copyText(out[key]);
        P.toast(ok ? 'Kopyalandı: data/' + fileNames[key] : 'Kopyalanamadı', ok ? 'success' : 'error');
      });
    });
    P.qsa('[data-dl]').forEach(function (b) {
      b.addEventListener('click', function () {
        var key = b.getAttribute('data-dl');
        P.download(fileNames[key], out[key]);
        P.toast('İndirildi: ' + fileNames[key], 'success');
      });
    });

    /* tutarsızlıklar */
    var issues = [];
    postIds.forEach(function (id) {
      if (!P.Store.posts[id]) issues.push('Dizinde var, dosya yok: p/' + id + '.js');
    });
    Object.keys(P.Store.posts).forEach(function (id) {
      if (postIds.indexOf(id) === -1) issues.push('Dosya yüklü ama dizinde yok: ' + id);
      var post = P.Store.posts[id];
      if (!P.Store.categories[post.category]) issues.push('Kategori tanımsız: ' + post.category + ' (' + id + ')');
      if (!P.Store.users[post.author]) issues.push('Yazar tanımsız: ' + post.author + ' (' + id + ')');
      if (!post.cover) issues.push('Kapak görseli yok: ' + id);
    });
    catIds.forEach(function (id) {
      if (!P.Store.categories[id]) issues.push('Kategori dizininde var, dosya yok: category/' + id + '.js');
    });
    userIds.forEach(function (id) {
      if (!P.Store.users[id]) issues.push('Yazar dizininde var, dosya yok: users/' + id + '.js');
    });

    var issueHost = P.qs('#adminIssues');
    issueHost.innerHTML = issues.length
      ? issues.map(function (t) {
        return '<div class="draft-item"><span style="color:var(--warn)">' + P.icon('star', 14) + '</span><span style="font-size:.8rem">' + P.esc(t) + '</span></div>';
      }).join('')
      : '<span class="muted" style="font-size:.84rem">Tutarsızlık yok. Her şey yerinde.</span>';

    /* gönderi listesi */
    var postHost = P.qs('#adminPosts');
    postHost.innerHTML = posts.length ? posts.map(function (p) {
      return '<div class="draft-item"><span style="min-width:0;flex:1"><b style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' +
        P.esc(p.title) + '</b><small>p/' + P.esc(p.slug) + '.js · ' + P.esc(P.formatDate(p.date)) + '</small></span>' +
        '<a class="btn btn--ghost btn--sm" href="post.html?slug=' + encodeURIComponent(p.slug) + '">Aç</a></div>';
    }).join('') : '<span class="muted" style="font-size:.84rem">Gönderi yok.</span>';
  });

  function stat(value, label) {
    return '<div class="stat"><b>' + P.num(value) + '</b><span>' + P.esc(label) + '</span></div>';
  }
})();

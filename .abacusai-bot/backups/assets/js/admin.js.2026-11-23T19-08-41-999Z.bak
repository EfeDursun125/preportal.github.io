/* =====================================================================
   PrePortal — admin panel (admin.html)
   Shows the index files (data/*.js) and lists inconsistencies.
   ===================================================================== */
(function () {
  var P = window.PrePortal;
  var T = P.t;

  document.addEventListener('preportal:ready', function () {
    var host = P.qs('#adminStats');
    if (!host) return;

    var posts = P.allPosts();
    var pub = P.publishedPosts();
    var cats = P.categoriesWithCount();
    var users = Object.keys(P.Store.users);

    host.innerHTML = [
      stat(pub.length, T('admin.published')),
      stat(cats.length, T('admin.categories')),
      stat(users.length, T('admin.authors')),
      stat(P.allTags().length, T('admin.tags'))
    ].join('');

    /* index files */
    var postIds = (window.PREPORTAL_POSTS || []).slice();
    var catIds = (window.PREPORTAL_CATEGORIES || []).slice();
    var userIds = (window.PREPORTAL_USERS || []).slice();

    var out = {
      posts: P.publish.buildIndexFile('PREPORTAL_POSTS', postIds, 'PrePortal — post index'),
      cats: P.publish.buildIndexFile('PREPORTAL_CATEGORIES', catIds, 'PrePortal — category index'),
      users: P.publish.buildIndexFile('PREPORTAL_USERS', userIds, 'PrePortal — author index')
    };

    var hosts = { posts: P.qs('#indexPosts'), cats: P.qs('#indexCats'), users: P.qs('#indexUsers') };
    if (hosts.posts) hosts.posts.innerHTML = P.publish.highlight(out.posts);
    if (hosts.cats) hosts.cats.innerHTML = P.publish.highlight(out.cats);
    if (hosts.users) hosts.users.innerHTML = P.publish.highlight(out.users);

    var fileNames = { posts: 'posts.js', cats: 'categories.js', users: 'users.js' };
    P.qsa('[data-copy]').forEach(function (b) {
      b.addEventListener('click', async function () {
        var key = b.getAttribute('data-copy');
        var ok = await P.copyText(out[key]);
        P.toast(ok ? T('admin.copied', { file: 'data/' + fileNames[key] }) : T('admin.copyFailed'), ok ? 'success' : 'error');
      });
    });
    P.qsa('[data-dl]').forEach(function (b) {
      b.addEventListener('click', function () {
        var key = b.getAttribute('data-dl');
        P.download(fileNames[key], out[key]);
        P.toast(T('admin.downloaded', { file: fileNames[key] }), 'success');
      });
    });

    /* inconsistencies */
    var postsDir = P.CFG.postsDir || 'p';
    var catDir = P.CFG.categoryDir || 'category';
    var usersDir = P.CFG.usersDir || 'users';

    var issues = [];
    postIds.forEach(function (id) {
      if (!P.Store.posts[id]) issues.push(T('admin.warnIndexNoFile', { path: postsDir + '/' + id + '.js' }));
    });
    Object.keys(P.Store.posts).forEach(function (id) {
      if (postIds.indexOf(id) === -1) issues.push(T('admin.warnFileNotIndexed', { slug: id }));
      var post = P.Store.posts[id];
      if (!P.Store.categories[post.category]) issues.push(T('admin.warnCategory', { cat: post.category, slug: id }));
      if (!P.Store.users[post.author]) issues.push(T('admin.warnAuthor', { author: post.author, slug: id }));
      if (!post.cover) issues.push(T('admin.warnCover', { slug: id }));
    });
    catIds.forEach(function (id) {
      if (!P.Store.categories[id]) issues.push(T('admin.warnCatIndexNoFile', { path: catDir + '/' + id + '.js' }));
    });
    userIds.forEach(function (id) {
      if (!P.Store.users[id]) issues.push(T('admin.warnUserIndexNoFile', { path: usersDir + '/' + id + '.js' }));
    });

    var issueHost = P.qs('#adminIssues');
    if (issueHost) {
      issueHost.innerHTML = issues.length
        ? issues.map(function (t) {
          return '<div class="draft-item"><span style="color:var(--warn)">' + P.icon('star', 14) + '</span><span style="font-size:.8rem">' + P.esc(t) + '</span></div>';
        }).join('')
        : '<span class="muted" style="font-size:.84rem">' + P.esc(T('admin.noIssues')) + '</span>';
    }

    /* post list */
    var postHost = P.qs('#adminPosts');
    if (postHost) {
      postHost.innerHTML = posts.length ? posts.map(function (p) {
        return '<div class="draft-item"><span style="min-width:0;flex:1"><b style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' +
          P.esc(p.title) + '</b><small>' + P.esc(postsDir + '/' + p.slug + '.js') + ' · ' + P.esc(P.formatDate(p.date)) + '</small></span>' +
          '<a class="btn btn--ghost btn--sm" href="post.html?slug=' + encodeURIComponent(p.slug) + '">' + P.esc(T('admin.open')) + '</a></div>';
      }).join('') : '<span class="muted" style="font-size:.84rem">' + P.esc(T('admin.noPosts')) + '</span>';
    }
  });

  function stat(value, label) {
    return '<div class="stat" data-reveal><b>' + P.num(value) + '</b><span>' + P.esc(label) + '</span></div>';
  }
})();

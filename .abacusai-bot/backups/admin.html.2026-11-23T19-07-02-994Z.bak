<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin — PrePortal</title>
  <meta name="description" content="PrePortal admin panel: inspect the content indexes (data/) and the loaded files.">
  <meta name="theme-color" content="#070b18">
  <link rel="icon" href="assets/img/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="assets/css/theme.css">
  <script>
    (function () {
      try {
        var m = localStorage.getItem('preportal:theme') || 'dark';
        var r = m === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : m;
        document.documentElement.setAttribute('data-theme', r === 'light' ? 'light' : 'dark');
      } catch (e) {}
    })();
  </script>
</head>
<body data-page="admin">

  <header class="site-header" data-header></header>

  <main class="studio">
    <div class="container">
      <div class="section-head" style="margin-bottom:18px">
        <div>
          <span class="eyebrow" data-i18n="admin.eyebrow"></span>
          <h1 style="font-size:clamp(1.6rem,1.2rem+1.4vw,2.2rem);margin:0" data-i18n="admin.title"></h1>
          <p data-i18n="admin.lead"></p>
        </div>
        <a class="btn btn--primary" href="create.html"><span data-i18n="admin.newPost"></span> →</a>
      </div>

      <div class="grid grid--3" id="adminStats" style="margin-bottom:22px"></div>

      <div class="studio-grid">
        <div>
          <div class="panel">
            <h4>data/posts.js</h4>
            <pre class="code-output" id="indexPosts" style="max-height:240px"></pre>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
              <button class="btn btn--ghost btn--sm" type="button" data-copy="posts" data-i18n="actions.copy"></button>
              <button class="btn btn--soft btn--sm" type="button" data-dl="posts" data-i18n="actions.download"></button>
            </div>
          </div>

          <div class="panel" style="margin-top:16px">
            <h4>data/categories.js</h4>
            <pre class="code-output" id="indexCats" style="max-height:180px"></pre>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
              <button class="btn btn--ghost btn--sm" type="button" data-copy="cats" data-i18n="actions.copy"></button>
              <button class="btn btn--soft btn--sm" type="button" data-dl="cats" data-i18n="actions.download"></button>
            </div>
          </div>

          <div class="panel" style="margin-top:16px">
            <h4>data/users.js</h4>
            <pre class="code-output" id="indexUsers" style="max-height:180px"></pre>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
              <button class="btn btn--ghost btn--sm" type="button" data-copy="users" data-i18n="actions.copy"></button>
              <button class="btn btn--soft btn--sm" type="button" data-dl="users" data-i18n="actions.download"></button>
            </div>
          </div>
        </div>

        <aside class="sidebar">
          <div class="panel">
            <h4 data-i18n="admin.warnings"></h4>
            <div id="adminIssues" class="draft-list"></div>
          </div>
          <div class="panel">
            <h4 data-i18n="admin.posts"></h4>
            <div id="adminPosts" class="draft-list" style="max-height:420px;overflow:auto"></div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <footer class="site-footer" data-footer></footer>

  <script src="data/config.js"></script>
  <script src="assets/js/i18n.js"></script>
  <script src="data/posts.js"></script>
  <script src="data/categories.js"></script>
  <script src="data/users.js"></script>
  <script src="assets/js/core.js"></script>
  <script src="assets/js/publisher.js"></script>
  <script src="assets/js/admin.js"></script>
  <script>
    window.PrePortal.ready();
  </script>
</body>
</html>

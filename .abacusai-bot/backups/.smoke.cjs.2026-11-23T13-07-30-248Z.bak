/* Basit duman testi: jsdom ile sayfaları yükleyip konsol hatalarını ve render çıktısını kontrol eder. */
const fs = require('fs');
const path = require('path');
const { JSDOM, VirtualConsole, ResourceLoader } = require('jsdom');

const root = __dirname;
const files = process.argv.slice(2);

function readAll(html) {
  return html;
}

async function run(file, url) {
  const errors = [];
  const vc = new VirtualConsole();
  vc.on('jsdomError', (e) => errors.push('jsdomError: ' + e.message));
  vc.on('error', (...a) => errors.push('console.error: ' + a.join(' ')));
  vc.on('warn', () => {});
  vc.on('log', () => {});
  const html = fs.readFileSync(path.join(root, file), 'utf8');
  const dom = new JSDOM(html, {
    url: 'https://example.github.io/preportal/' + url,
    runScripts: 'dangerously',
    resources: new ResourceLoader({ userAgent: 'Mozilla/5.0 jsdom' }),
    pretendToBeVisual: true,
    virtualConsole: vc,
    beforeParse(win) {
      win.matchMedia = () => ({ matches: false, addEventListener() {}, removeEventListener() {} });
      win.IntersectionObserver = class { observe(el) { el.classList.add('is-revealed'); } unobserve() {} disconnect() {} };
      win.scrollTo = () => {};
      win.fetch = () => Promise.reject(new Error('no fetch in test'));
      win.alert = () => {};
    }
  });

  // (scriptler jsdom ResourceLoader ile yüklenir)
  if (false) {
  const scripts = Array.from(dom.window.document.querySelectorAll('script[src]')).map(s => s.getAttribute('src'));
  for (const src of scripts) {
    const p = path.join(root, src);
    if (!fs.existsSync(p)) { errors.push('missing script: ' + src); continue; }
    const code = fs.readFileSync(p, 'utf8');
    try {
      dom.window.eval(code);
    } catch (e) {
      errors.push('script error ' + src + ': ' + e.message);
    }
  }
  // inline scriptleri çalıştır
  const inline = Array.from(dom.window.document.querySelectorAll('script:not([src])'));
  for (const s of inline) {
    try { dom.window.eval(s.textContent); } catch (e) { errors.push('inline error: ' + e.message); }
  }

  await new Promise(r => setTimeout(r, 1200));

  const doc = dom.window.document;
  const summary = {
    file,
    title: doc.title,
    headerMounted: !!doc.querySelector('.header-inner .brand'),
    footerMounted: !!doc.querySelector('.footer-inner'),
    nodes: {
      latest: (doc.querySelector('#latestPosts') || {}).children ? doc.querySelector('#latestPosts').children.length : null,
      archive: (doc.querySelector('#archiveGrid') || {}).children ? doc.querySelector('#archiveGrid').children.length : null,
      cat: (doc.querySelector('#catGrid') || {}).children ? doc.querySelector('#catGrid').children.length : null,
      post: doc.querySelector('#postRoot .article-title') ? doc.querySelector('#postRoot .article-title').textContent : null,
      user: doc.querySelector('#userHero h1') ? doc.querySelector('#userHero h1').textContent : null,
    },
    errors
  };
  console.log(JSON.stringify(summary, null, 1));
  dom.window.close();
}

(async () => {
  const targets = files.length ? files : ['index.html', 'blog.html', 'category.html', 'post.html?slug=preportal-nasil-calisir', 'user.html?u=preportal', 'apps.html', 'games.html', 'create.html'];
  for (const t of targets) {
    const [f, q] = t.split('?');
    await run(f, t);
  }
})();
